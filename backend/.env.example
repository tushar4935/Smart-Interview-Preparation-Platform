# --- core ---
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/smart-interview-prep
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRE=30d

# comma-separated list is allowed (prod domain + vercel preview, etc.)
CLIENT_URL=http://localhost:5173

# --- ai (get a free key at https://aistudio.google.com/app/apikey) ---
# leave blank to run on the keyword-scoring fallback only
GEMINI_API_KEY=

# --- logging ---
LOG_LEVEL=debug

# --- email (optional) ---
# without SMTP_HOST, verification/reset links are just logged to the console
EMAIL_FROM=Interview Prep <no-reply@interviewprep.dev>
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
